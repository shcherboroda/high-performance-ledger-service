# Copy to benchmarks/local.env and replace paths and connection details for your machine.
# This file contains no key material. Use a dedicated database ending in _benchmark.
BENCHMARK_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/ledger_benchmark
SERVICE_URLS=http://127.0.0.1:3000
BENCHMARK_JWT_ISSUER=benchmark-issuer
BENCHMARK_JWT_AUDIENCE=ledger
BENCHMARK_JWT_PRIVATE_KEY=/absolute/path/to/ledger-benchmark-private.pem
BENCHMARK_JWT_PUBLIC_KEY=/absolute/path/to/ledger-benchmark-public.pem
RUST_LOG=warn
BENCHMARK_DB_POOL_ASSUMPTIONS="1 local service instance; application default DB pool configuration"
BENCHMARK_TELEMETRY_MODE="RUST_LOG=warn; process-local Prometheus snapshots before and after each measured level"
