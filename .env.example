# Local application runtime configuration only. Copy to .env and replace the JWT placeholder
# with an issuer's public RSA key; never commit .env or a real key.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/ledger
JWT_ISSUER=https://issuer.example
JWT_AUDIENCE=ledger-service
# JWT_PUBLIC_KEY_PEM="$(cat /absolute/path/to/issuer-public-key.pem)"

# Optional local overrides.
BIND_ADDRESS=0.0.0.0:3000
DB_MAX_CONNECTIONS=10
RUST_LOG=info
